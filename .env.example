# Copy to .env for local docker compose (defaults match compose file)

# PostgreSQL (server)
POSTGRES_USER=homehub
POSTGRES_PASSWORD=homehub
POSTGRES_DB=homehub

# API
DATABASE_URL=postgresql+psycopg://homehub:homehub@localhost:5432/homehub
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=change-me-for-production-use-at-least-32-characters
JWT_EXPIRE_MINUTES=10080

# Mobile (LAN — set to your PC's LAN IP when testing on device)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
